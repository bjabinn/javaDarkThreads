      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "nullPointMode": "null",
      "targets": [
        {
          "expr": "(jvm_memory_used_bytes{area=\"heap\",app=\"web-server-blocking\"} / jvm_memory_max_bytes{area=\"heap\",app=\"web-server-blocking\"}) * 100",
