{
  "uid": "jvm-threads-blocking",
  "title": "Monitoreo JVM y Comparación de Hilos - Versiones Bloqueantes",
  "tags": ["java", "jvm", "metrics", "monitoring", "threads", "performance", "blocking"],
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "jvm_memory_used_bytes{area=\"heap\"}",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "nullPointMode": "null",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\",app=\"web-server-blocking\"}",
          "legendFormat": "Memoria Heap Utilizada - web-server-blocking",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\",app=\"web-client-blocking\"}",
          "legendFormat": "Memoria Heap Utilizada - web-client-blocking",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "bytes", "label": "Memoria"},
        {"format": "short"}
      ],
      "description": "Memoria heap utilizada por las aplicaciones bloqueantes (platform threads)"
    },
    {
      "id": 2,
      "title": "jvm_memory_max_bytes{area=\"heap\"}",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
