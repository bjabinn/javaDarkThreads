          "refId": "A"
        },
        {
          "expr": "(jvm_memory_used_bytes{area=\"heap\",app=\"web-client-blocking\"} / jvm_memory_max_bytes{area=\"heap\",app=\"web-client-blocking\"}) * 100",
          "legendFormat": "Porcentaje de Uso de Heap - web-client-blocking",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "percent", "label": "Uso", "max": 100, "min": 0},
        {"format": "short"}
      ],
      "alert": {
        "conditions": [
          {
            "evaluator": {"params": [85], "type": "gt"},
            "operator": {"type": "and"},
            "query": {"params": ["A", "5m", "now"]},
            "reducer": {"params": [], "type": "avg"},
            "type": "query"
          }
        ],
        "name": "Alerta de Uso Alto de Heap"
      },
      "description": "Porcentaje de uso de memoria heap. Alerta cuando supera el 85%"
