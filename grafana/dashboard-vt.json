{
  "uid": "jvm-threads-vt",
  "title": "Monitoreo JVM y Comparación de Hilos - Virtual Threads",
  "tags": ["java", "jvm", "metrics", "monitoring", "threads", "performance", "virtual-threads", "loom"],
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Memoria Heap Utilizada",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\",app=\"web-server-vt\"}",
          "legendFormat": "web-server-vt - Heap Utilizada",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\",app=\"web-client-vt\"}",
          "legendFormat": "web-client-vt - Heap Utilizada",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "bytes", "label": "Memoria"},
        {"format": "short"}
      ],
      "description": "Memoria heap utilizada por las aplicaciones de virtual threads"
    },
    {
      "id": 2,
      "title": "Memoria Heap Máxima",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\",app=\"web-server-vt\"}",
          "legendFormat": "web-server-vt - Heap Máxima",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\",app=\"web-client-vt\"}",
          "legendFormat": "web-client-vt - Heap Máxima",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "bytes", "label": "Memoria"},
        {"format": "short"}
      ],
      "description": "Memoria heap máxima configurada"
    },
    {
      "id": 3,
      "title": "Porcentaje de Uso de Heap",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "(jvm_memory_used_bytes{area=\"heap\",app=\"web-server-vt\"} / jvm_memory_max_bytes{area=\"heap\",app=\"web-server-vt\"}) * 100",
          "legendFormat": "web-server-vt - Uso de Heap %",
          "refId": "A"
        },
        {
          "expr": "(jvm_memory_used_bytes{area=\"heap\",app=\"web-client-vt\"} / jvm_memory_max_bytes{area=\"heap\",app=\"web-client-vt\"}) * 100",
          "legendFormat": "web-client-vt - Uso de Heap %",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "percent", "label": "Uso", "max": 100, "min": 0},
        {"format": "short"}
      ],
      "alert": {
        "conditions": [
          {
            "evaluator": {"params": [85], "type": "gt"},
            "operator": {"type": "and"},
            "query": {"params": ["A", "5m", "now"]},
            "reducer": {"params": [], "type": "avg"},
            "type": "query"
          }
        ],
        "name": "Alerta de Uso Alto de Heap - VT"
      },
      "description": "Porcentaje de uso de memoria heap. Alerta cuando supera el 85%"
    },
    {
      "id": 4,
      "title": "Memoria RSS del Proceso",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "process_resident_memory_bytes{app=\"web-server-vt\"}",
          "legendFormat": "web-server-vt - Memoria RSS",
          "refId": "A"
        },
        {
          "expr": "process_resident_memory_bytes{app=\"web-client-vt\"}",
          "legendFormat": "web-client-vt - Memoria RSS",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "bytes", "label": "Memoria"},
        {"format": "short"}
      ],
      "description": "Resident Set Size (RSS) - Memoria física utilizada por el proceso"
    },
    {
      "id": 5,
      "title": "Hilos Vivos por Aplicación",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "jvm_threads_live_threads{app=\"web-server-vt\"}",
          "legendFormat": "web-server-vt - Hilos Vivos",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_live_threads{app=\"web-client-vt\"}",
          "legendFormat": "web-client-vt - Hilos Vivos",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "short", "label": "Hilos"},
        {"format": "short"}
      ],
      "description": "Total de hilos vivos por aplicación (virtual threads incluidos)"
    },
    {
      "id": 6,
      "title": "Hilos Daemon",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "jvm_threads_daemon_threads{app=\"web-server-vt\"}",
          "legendFormat": "web-server-vt - Hilos Daemon",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{app=\"web-client-vt\"}",
          "legendFormat": "web-client-vt - Hilos Daemon",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "short", "label": "Hilos"},
        {"format": "short"}
      ],
      "description": "Número de hilos daemon activos"
    },
    {
      "id": 7,
      "title": "Hilos por Estado",
      "type": "graph",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "targets": [
        {
          "expr": "jvm_threads_states_threads{app=\"web-server-vt\",state=\"runnable\"}",
          "legendFormat": "web-server-vt - Ejecutable",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_states_threads{app=\"web-server-vt\",state=\"blocked\"}",
          "legendFormat": "web-server-vt - Bloqueado",
          "refId": "B"
        },
        {
          "expr": "jvm_threads_states_threads{app=\"web-server-vt\",state=\"waiting\"}",
          "legendFormat": "web-server-vt - Esperando",
          "refId": "C"
        },
        {
          "expr": "jvm_threads_states_threads{app=\"web-server-vt\",state=\"timed-waiting\"}",
          "legendFormat": "web-server-vt - Esperando con Tiempo",
          "refId": "D"
        },
        {
          "expr": "jvm_threads_states_threads{app=\"web-client-vt\",state=\"runnable\"}",
          "legendFormat": "web-client-vt - Ejecutable",
          "refId": "E"
        },
        {
          "expr": "jvm_threads_states_threads{app=\"web-client-vt\",state=\"blocked\"}",
          "legendFormat": "web-client-vt - Bloqueado",
          "refId": "F"
        },
        {
          "expr": "jvm_threads_states_threads{app=\"web-client-vt\",state=\"waiting\"}",
          "legendFormat": "web-client-vt - Esperando",
          "refId": "G"
        },
        {
          "expr": "jvm_threads_states_threads{app=\"web-client-vt\",state=\"timed-waiting\"}",
          "legendFormat": "web-client-vt - Esperando con Tiempo",
          "refId": "H"
        }
      ],
      "yaxes": [
        {"format": "short", "label": "Hilos"},
        {"format": "short"}
      ],
      "description": "Distribución de hilos por estado. Con virtual threads, 'blocked' debe ser prácticamente 0 ya que se desmontan del carrier thread al hacer I/O"
    },
    {
      "id": 8,
      "title": "Uso de CPU por Aplicación",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "targets": [
        {
          "expr": "process_cpu_usage{app=\"web-server-vt\"}",
          "legendFormat": "web-server-vt - Uso de CPU",
          "refId": "A"
        },
        {
          "expr": "process_cpu_usage{app=\"web-client-vt\"}",
          "legendFormat": "web-client-vt - Uso de CPU",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "percentunit", "label": "CPU", "max": 1, "min": 0},
        {"format": "short"}
      ],
      "description": "Porcentaje de uso de CPU por aplicación"
    },
    {
      "id": 9,
      "title": "Tiempo de CPU del Sistema",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "targets": [
        {
          "expr": "system_cpu_usage{app=\"web-server-vt\"}",
          "legendFormat": "web-server-vt - CPU Sistema",
          "refId": "A"
        },
        {
          "expr": "system_cpu_usage{app=\"web-client-vt\"}",
          "legendFormat": "web-client-vt - CPU Sistema",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "percentunit", "label": "CPU", "max": 1, "min": 0},
        {"format": "short"}
      ],
      "description": "Uso de CPU del sistema operativo"
    },
    {
      "id": 10,
      "title": "Throughput HTTP (Peticiones/seg)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{app=\"web-server-vt\"}[1m])",
          "legendFormat": "web-server-vt - Peticiones/seg",
          "refId": "A"
        },
        {
          "expr": "rate(http_server_requests_seconds_count{app=\"web-client-vt\"}[1m])",
          "legendFormat": "web-client-vt - Peticiones/seg",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "reqps", "label": "Peticiones/seg"},
        {"format": "short"}
      ],
      "description": "Tasa de peticiones HTTP procesadas por segundo"
    },
    {
      "id": 11,
      "title": "Latencia Media de Respuesta HTTP",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_sum{app=\"web-server-vt\"}[1m]) / rate(http_server_requests_seconds_count{app=\"web-server-vt\"}[1m])",
          "legendFormat": "web-server-vt - Latencia Media",
          "refId": "A"
        },
        {
          "expr": "rate(http_server_requests_seconds_sum{app=\"web-client-vt\"}[1m]) / rate(http_server_requests_seconds_count{app=\"web-client-vt\"}[1m])",
          "legendFormat": "web-client-vt - Latencia Media",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "s", "label": "Latencia"},
        {"format": "short"}
      ],
      "description": "Latencia media de respuesta HTTP"
    },
    {
      "id": 12,
      "title": "Tasa de Garbage Collection",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48},
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{app=\"web-server-vt\"}[1m])",
          "legendFormat": "web-server-vt - Tasa de GC",
          "refId": "A"
        },
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{app=\"web-client-vt\"}[1m])",
          "legendFormat": "web-client-vt - Tasa de GC",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "s", "label": "Tiempo de GC"},
        {"format": "short"}
      ],
      "description": "Tasa de tiempo consumido por el Garbage Collector"
    },
    {
      "id": 13,
      "title": "Conteo de Recolecciones de Basura",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48},
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_count{app=\"web-server-vt\"}[1m])",
          "legendFormat": "web-server-vt - Recolecciones/seg",
          "refId": "A"
        },
        {
          "expr": "rate(jvm_gc_pause_seconds_count{app=\"web-client-vt\"}[1m])",
          "legendFormat": "web-client-vt - Recolecciones/seg",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "ops", "label": "GC/seg"},
        {"format": "short"}
      ],
      "description": "Frecuencia de ejecuciones del Garbage Collector por segundo"
    },
    {
      "id": 14,
      "title": "Latencia P95 HTTP",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{app=\"web-server-vt\"}[1m]))",
          "legendFormat": "web-server-vt - P95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{app=\"web-client-vt\"}[1m]))",
          "legendFormat": "web-client-vt - P95",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "s", "label": "Latencia"},
        {"format": "short"}
      ],
      "description": "Percentil 95 de latencia HTTP. El 95% de las peticiones responden por debajo de este valor. Con virtual threads debe mantenerse estable bajo carga"
    },
    {
      "id": 15,
      "title": "Latencia P99 HTTP",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{app=\"web-server-vt\"}[1m]))",
          "legendFormat": "web-server-vt - P99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{app=\"web-client-vt\"}[1m]))",
          "legendFormat": "web-client-vt - P99",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"format": "s", "label": "Latencia"},
        {"format": "short"}
      ],
      "description": "Percentil 99 de latencia HTTP (cola larga). Con virtual threads no hay thread starvation, por lo que este valor no se dispara bajo carga a diferencia de los hilos de plataforma"
    },
    {
      "id": 16,
      "title": "Tasa de Errores HTTP (%)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 64},
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{app=\"web-server-vt\",status=~\"5..\"}[1m]) / rate(http_server_requests_seconds_count{app=\"web-server-vt\"}[1m]) * 100",
          "legendFormat": "web-server-vt - Errores 5xx %",
          "refId": "A"
        },
        {
          "expr": "rate(http_server_requests_seconds_count{app=\"web-client-vt\",status=~\"5..\"}[1m]) / rate(http_server_requests_seconds_count{app=\"web-client-vt\"}[1m]) * 100",
          "legendFormat": "web-client-vt - Errores 5xx %",
          "refId": "B"
        },
        {
          "expr": "rate(load_requests_failure_total{app=\"web-client-vt\"}[1m]) / rate(load_requests_total_total{app=\"web-client-vt\"}[1m]) * 100",
          "legendFormat": "web-client-vt - Fallos de carga %",
          "refId": "C"
        }
      ],
      "yaxes": [
        {"format": "percent", "label": "Errores %", "min": 0},
        {"format": "short"}
      ],
      "description": "Tasa de errores HTTP. Con virtual threads no hay rechazo de peticiones por pool agotado, a diferencia de los hilos de plataforma donde los errores suben cuando el pool se satura"
    }
  ],
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m"]
  },
  "refresh": "5s",
  "schemaVersion": 16,
  "version": 1
}
