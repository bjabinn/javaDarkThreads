  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "jvm_memory_used_bytes{area=\"heap\"}",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (app) (jvm_memory_used_bytes{area=\"heap\",app=\"web-server-reactive\"})",
          "legendFormat": "web-server-reactive - Heap Utilizada",
          "refId": "A"
        },
        {
          "expr": "sum by (app) (jvm_memory_used_bytes{area=\"heap\",app=\"web-client-reactive\"})",
          "legendFormat": "web-client-reactive - Heap Utilizada",
          "refId": "B"
        }
      ],
      "yaxes": [
        {
          "format": "bytes",
          "label": "Memoria"
        },
        {
          "format": "short"
        }
      ],
      "description": "Memoria heap utilizada por las aplicaciones reactivas (virtual threads)",
      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "nullPointMode": "null"
    },
    {
      "id": 2,
