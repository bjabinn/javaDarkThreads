    {
      "id": 3,
      "title": "(jvm_memory_used_bytes{area=\"heap\"} / jvm_memory_max_bytes{area=\"heap\"}) * 100",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "(sum by (app) (jvm_memory_used_bytes{area=\"heap\",app=\"web-server-reactive\"}) / sum by (app) (jvm_memory_max_bytes{area=\"heap\",app=\"web-server-reactive\"})) * 100",
          "legendFormat": "web-server-reactive - Uso Heap %",
          "refId": "A"
        },
        {
          "expr": "(sum by (app) (jvm_memory_used_bytes{area=\"heap\",app=\"web-client-reactive\"}) / sum by (app) (jvm_memory_max_bytes{area=\"heap\",app=\"web-client-reactive\"})) * 100",
          "legendFormat": "web-client-reactive - Uso Heap %",
          "refId": "B"
        }
      ],
      "yaxes": [
        {
          "format": "percent",
          "label": "Uso",
          "max": 100,
          "min": 0
        },
        {
          "format": "short"
        }
      ],
      "alert": {
        "conditions": [
          {
            "evaluator": {
              "params": [
                85
              ],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "A",
                "5m",
                "now"
              ]
            },
            "reducer": {
              "params": [],
              "type": "avg"
            },
            "type": "query"
          }
        ],
        "name": "Alerta de Uso Alto de Heap"
