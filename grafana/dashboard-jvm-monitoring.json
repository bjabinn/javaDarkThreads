{
  "uid": "jvm-monitoring",
  "title": "JVM Metrics - Applications Monitoring",
  "tags": ["java", "jvm", "metrics", "monitoring"],
  "timezone": "browser",
  "editable": true,
  "panels": [
      {
        "id": 1,
        "title": "Heap Memory Used",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{area=\"heap\",app=\"web-server\"}",
            "legendFormat": "web-server - Heap Used",
            "refId": "A"
          },
          {
            "expr": "jvm_memory_used_bytes{area=\"heap\",app=\"web-client\"}",
            "legendFormat": "web-client - Heap Used",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "bytes", "label": "Memory"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Heap Memory Max",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "jvm_memory_max_bytes{area=\"heap\",app=\"web-server\"}",
            "legendFormat": "web-server - Heap Max",
            "refId": "A"
          },
          {
            "expr": "jvm_memory_max_bytes{area=\"heap\",app=\"web-client\"}",
            "legendFormat": "web-client - Heap Max",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "bytes", "label": "Memory"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Heap Usage Percentage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "(jvm_memory_used_bytes{area=\"heap\",app=\"web-server\"} / jvm_memory_max_bytes{area=\"heap\",app=\"web-server\"}) * 100",
            "legendFormat": "web-server - Heap Usage %",
            "refId": "A"
          },
          {
            "expr": "(jvm_memory_used_bytes{area=\"heap\",app=\"web-client\"} / jvm_memory_max_bytes{area=\"heap\",app=\"web-client\"}) * 100",
            "legendFormat": "web-client - Heap Usage %",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Usage", "max": 100, "min": 0},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [85], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "name": "High Heap Usage Alert"
        }
      },
      {
        "id": 4,
        "title": "Live Threads",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "jvm_threads_live_threads{app=\"web-server\"}",
            "legendFormat": "web-server - Live Threads",
            "refId": "A"
          },
          {
            "expr": "jvm_threads_live_threads{app=\"web-client\"}",
            "legendFormat": "web-client - Live Threads",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Threads"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Threads by State",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "jvm_threads_states_threads{app=\"web-server\",state=\"runnable\"}",
            "legendFormat": "web-server - Runnable",
            "refId": "A"
          },
          {
            "expr": "jvm_threads_states_threads{app=\"web-server\",state=\"blocked\"}",
            "legendFormat": "web-server - Blocked",
            "refId": "B"
          },
          {
            "expr": "jvm_threads_states_threads{app=\"web-server\",state=\"waiting\"}",
            "legendFormat": "web-server - Waiting",
            "refId": "C"
          },
          {
            "expr": "jvm_threads_states_threads{app=\"web-server\",state=\"timed-waiting\"}",
            "legendFormat": "web-server - Timed Waiting",
            "refId": "D"
          },
          {
            "expr": "jvm_threads_states_threads{app=\"web-client\",state=\"runnable\"}",
            "legendFormat": "web-client - Runnable",
            "refId": "E"
          },
          {
            "expr": "jvm_threads_states_threads{app=\"web-client\",state=\"blocked\"}",
            "legendFormat": "web-client - Blocked",
            "refId": "F"
          },
          {
            "expr": "jvm_threads_states_threads{app=\"web-client\",state=\"waiting\"}",
            "legendFormat": "web-client - Waiting",
            "refId": "G"
          },
          {
            "expr": "jvm_threads_states_threads{app=\"web-client\",state=\"timed-waiting\"}",
            "legendFormat": "web-client - Timed Waiting",
            "refId": "H"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Threads"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "process_cpu_usage{app=\"web-server\"}",
            "legendFormat": "web-server - CPU Usage",
            "refId": "A"
          },
          {
            "expr": "process_cpu_usage{app=\"web-client\"}",
            "legendFormat": "web-client - CPU Usage",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "CPU", "max": 1, "min": 0},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "Garbage Collection Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "rate(jvm_gc_pause_seconds_sum{app=\"web-server\"}[1m])",
            "legendFormat": "web-server - GC Rate",
            "refId": "A"
          },
          {
            "expr": "rate(jvm_gc_pause_seconds_sum{app=\"web-client\"}[1m])",
            "legendFormat": "web-client - GC Rate",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "GC Time"},
          {"format": "short"}
        ]
      },
      {
        "id": 8,
        "title": "HTTP Requests Throughput",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count{app=\"web-server\"}[1m])",
            "legendFormat": "web-server - Requests/sec",
            "refId": "A"
          },
          {
            "expr": "rate(http_server_requests_seconds_count{app=\"web-client\"}[1m])",
            "legendFormat": "web-client - Requests/sec",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 9,
        "title": "Process Resident Memory (RSS)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "process_resident_memory_bytes{app=\"web-server\"}",
            "legendFormat": "web-server - RSS Memory",
            "refId": "A"
          },
          {
            "expr": "process_resident_memory_bytes{app=\"web-client\"}",
            "legendFormat": "web-client - RSS Memory",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "bytes", "label": "Memory"},
          {"format": "short"}
        ],
        "description": "Resident Set Size (RSS) - Physical memory used by the process"
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "timepicker": {
      "refresh_intervals": ["2s", "5s", "10s", "30s", "1m", "5m"]
    },
    "refresh": "2s",
    "schemaVersion": 16,
    "version": 2
}